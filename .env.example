# Copy to .env and fill in. Never commit real values.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Used by apps/web (must be prefixed NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://zenora:zenora@localhost:5432/zenora

# --- Redis (cache + BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible: recordings, media, uploads) ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=zenora-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
# Random 32+ char secret used to sign session cookies / JWTs.
AUTH_SECRET=
SESSION_COOKIE_NAME=zenora_session
# 32-byte hex key that encrypts channel access tokens at rest. Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Google OAuth (sign-in with Google, Calendar connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# OTP SMS/WhatsApp (login verification) — MSG91 or similar, DLT registered
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SENDER_ID=
OTP_DLT_TEMPLATE_ID=

# --- Meta (Instagram + WhatsApp + Ads) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TECH_PROVIDER_ID=
META_GRAPH_API_VERSION=v21.0
# Exposed to the browser for the WhatsApp Embedded Signup JS SDK (apps/web).
# NEXT_PUBLIC_META_APP_ID must match META_APP_ID above.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=
AI_MODEL_VOLUME=claude-haiku-4-5
AI_MODEL_SUMMARY=claude-sonnet-5

# --- Speech-to-text (Sarvam AI Saaras) ---
SARVAM_API_KEY=

# --- Meeting bot (Recall.ai) ---
RECALL_API_KEY=

# --- Telephony (customer's own account — per-workspace, not global) ---
# Configured per workspace in-app; no global keys required here.

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (AWS SES or Zoho ZeptoMail) ---
EMAIL_FROM=no-reply@zenora.app
SES_REGION=ap-south-1
ZEPTOMAIL_API_KEY=

# --- Push (Firebase Cloud Messaging) ---
FCM_SERVER_KEY=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature flags ---
FEATURE_FLAGS_DEFAULT=off
