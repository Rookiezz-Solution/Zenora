// Zenora — Prisma schema v1
// Covers Phase 0 (foundations) and Phase 1 (capture + automate MVP) tables.
// See docs/ARCHITECTURE.md for the full target data model and docs/ROADMAP.md
// for phasing. Phase 2/3 tables (calls, meetings, AI knowledge, partners,
// API keys/webhooks) are added when those phases start.
//
// Every business-data table carries workspaceId and MUST be filtered by it
// on every query (CLAUDE.md non-negotiable rule #7). Postgres RLS is added
// alongside app-layer checks before pilot launch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 2 adds `previewFeatures = ["postgresqlExtensions"]` above and a
// pgvector extension block once kb_chunks (AI knowledge search) lands.

// ---------------------------------------------------------------------------
// Phase 0 — workspaces, membership, RBAC, audit
// ---------------------------------------------------------------------------

enum WorkspaceMode {
  team
  creator
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  mode      WorkspaceMode @default(team)
  industry  String?
  timezone  String        @default("Asia/Kolkata")
  currency  String        @default("INR")
  locales   String[]      @default(["en"])
  labels    Json          @default("{}") // terminology overrides, see @zenora/shared DEFAULT_LABELS
  planId    String        @default("free")
  slaMinutes Int          @default(30) // speed rule: respond within N minutes else reassign (docs/PRD.md section 10)
  billingName    String? // legal/trade name on the GST invoice
  gstin          String?
  billingAddress String?
  agencyId       String? // set when this workspace is managed by an agency
  messageRetentionDays Int? // null = keep messages until deleted; otherwise older messages are purged daily
  deletionScheduledAt DateTime? // set when the owner asked to delete the workspace; the daily job deletes it after the grace period
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships   Membership[]
  invites       Invite[]
  auditLogs     AuditLog[]
  notifications Notification[]
  featureFlags  WorkspaceFeatureFlag[]

  instagramAccounts InstagramAccount[]
  whatsappNumbers   WhatsappNumber[]
  adAccounts        AdAccount[]
  apiKeys           ApiKey[]
  limitOverride     WorkspaceLimitOverride?
  agency            Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  referral          Referral?
  webhookEndpoints  WebhookEndpoint[]

  leads         Lead[]
  tags          Tag[]
  pipelines     Pipeline[]
  customFields  CustomField[]
  conversations Conversation[]

  automations   Automation[]
  savedTriggers SavedTrigger[]
  flowTemplates FlowTemplate[]

  waTemplates          WaTemplate[]
  broadcasts           Broadcast[]
  quickReplies         QuickReply[]
  media                Media[]

  routingRules  RoutingRule[]
  scoringRules  ScoringRule[]
  slaTimers     SlaTimer[]

  tasks     Task[]
  sequences Sequence[]

  subscription  Subscription?
  invoices      Invoice[]
  addons        WorkspaceAddon[]
  usageEvents   UsageEvent[]
  usageMonthly  UsageMonthly[]
  creditLedger  CreditLedger[]

  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  faqs             Faq[]
  aiSettings       AiSettings?
  linkInBio        LinkInBioPage?
  calendarAccounts CalendarAccount[]
  appointmentTypes AppointmentType[]
  appointments     Appointment[]

  @@index([planId])
}

enum WorkspaceRole {
  owner
  admin
  manager
  sales
  viewer
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerifiedAt   DateTime?
  phone             String?   @unique
  phoneVerifiedAt   DateTime?
  passwordHash      String?
  sessionVersion    Int       @default(0) // bumped to sign out every existing session (e.g. when an unverified account is claimed)
  googleId          String?   @unique
  name              String?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships  Membership[]
  agencyMemberships AgencyMember[]
  referralCode      ReferralCode?
  otpCodes     OtpCode[]
  auditLogs    AuditLog[]
  assignments  Assignment[]
  notes        Note[]        @relation("NoteAuthor")
}

model Membership {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(sales)
  teamId      String?
  available   Boolean       @default(true) // team availability toggle for routing's least-busy/round-robin fallback
  viaAgencyId String? // set when this access exists only because of an agency; removed when the agency link goes
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  memberships Membership[]

  @@index([workspaceId])
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

model Invite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  teamId      String?
  status      InviteStatus @default(pending)
  token       String       @unique
  invitedById String?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  target    String // phone number or email the code was sent to
  codeHash  String
  purpose   String // "login" | "signup" | "phone_verify"
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String // e.g. "member.invited", "lead.deleted", "automation.published"
  entityType  String
  entityId    String?
  metadata    Json     @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model FeatureFlag {
  key         String   @id
  description String?
  enabledByDefault Boolean @default(false)

  workspaceOverrides WorkspaceFeatureFlag[]
}

model WorkspaceFeatureFlag {
  id          String  @id @default(cuid())
  workspaceId String
  flagKey     String
  enabled     Boolean

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flag      FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([workspaceId, flagKey])
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  type        String
  title       String
  body        String?
  channel     String // "app" | "whatsapp" | "email"
  readAt      DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

// ---------------------------------------------------------------------------
// Phase 1 — channels
// ---------------------------------------------------------------------------

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  igUserId          String   @unique
  username          String?
  accessTokenCipher String // encrypted at rest
  tokenExpiresAt    DateTime?
  connectedAt       DateTime @default(now())
  status            String   @default("active")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WhatsappNumber {
  id                 String   @id @default(cuid())
  workspaceId        String
  wabaId             String
  phoneNumberId      String   @unique
  displayPhoneNumber String
  accessTokenCipher  String
  status             String   @default("active")
  connectedAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AdAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  provider          String // "meta" | "google"
  externalAccountId String
  accessTokenCipher String?
  connectedAt       DateTime @default(now())
  // inactive = found on the user's Meta login but not chosen for tracking yet;
  // active = synced; error = last sync failed (e.g. token expired, reconnect).
  status            String   @default("active")
  name              String?
  currency          String?
  tokenExpiresAt    DateTime?
  lastSyncedAt      DateTime?
  lastError         String?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stats     AdDailyStat[]

  @@unique([workspaceId, provider, externalAccountId])
  @@index([workspaceId])
}

// One row per ad per day, synced from Meta's Insights API. Spend is stored in
// integer minor units (paise/cents) of the account currency.
model AdDailyStat {
  id            String   @id @default(cuid())
  workspaceId   String
  adAccountId   String
  date          String // "YYYY-MM-DD", the account's reporting day
  adId          String
  adName        String?
  campaignId    String
  campaignName  String
  spendMinor    Int      @default(0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, date, adId])
  @@index([workspaceId, date])
}

// Raw inbound Meta webhook events. Signature-verified and stored before
// enqueueing, so ingress is idempotent (by externalId) and replayable if a
// processor bug needs a re-run. docs/ARCHITECTURE.md: "verify Meta
// signatures, store raw event, enqueue; idempotent by event id."
model MetaWebhookEvent {
  id          String    @id @default(cuid())
  source      String // "instagram" | "whatsapp"
  externalId  String    @unique // hash of the payload when Meta gives no stable id
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([source, processedAt])
}

// ---------------------------------------------------------------------------
// Phase 1 — leads / CRM
// ---------------------------------------------------------------------------

model Lead {
  id          String   @id @default(cuid())
  workspaceId String
  name        String?
  phone       String?
  email       String?
  source      String? // "instagram" | "whatsapp" | "manual" | "import" | "ad"
  score       Int      @default(0) // ruleScore + aiIntentScore, kept in sync at every write site
  ruleScore   Int      @default(0)
  aiIntentScore Int    @default(0)
  aiScoreReasoning String?
  ownerId     String?
  pipelineId  String?
  stageId     String?
  lostReason  String? // captured when moved to a lost-type stage (docs/PRD.md Reports section)
  adId        String? // Meta ad that opened the chat (first-touch attribution)
  adReferral  Json?
  mergedIntoId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline?  @relation(fields: [pipelineId], references: [id])
  stage     Stage?     @relation(fields: [stageId], references: [id])
  mergedInto Lead?     @relation("LeadMerge", fields: [mergedIntoId], references: [id])
  mergedFrom Lead[]    @relation("LeadMerge")

  identities   LeadIdentity[]
  fieldValues  LeadFieldValue[]
  tags         LeadTag[]
  notes        Note[]
  consents     Consent[]
  conversations Conversation[]
  assignments  Assignment[]
  tasks        Task[]
  sequenceEnrollments SequenceEnrollment[]
  automationRuns AutomationRun[]
  broadcastRecipients BroadcastRecipient[]

  @@index([workspaceId, pipelineId, stageId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, phone])
  @@index([workspaceId, adId])
  @@index([workspaceId, email])
}

model LeadIdentity {
  id     String @id @default(cuid())
  leadId String
  type   String // "ig_scoped_id" | "wa_phone" | "email"
  value  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([leadId])
}

model CustomField {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  label       String
  type        String // "text" | "number" | "date" | "select" | "multiselect" | "boolean"
  options     Json?    // for select/multiselect
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    LeadFieldValue[]

  @@unique([workspaceId, key])
}

model LeadFieldValue {
  id      String @id @default(cuid())
  leadId  String
  fieldId String
  value   Json

  lead  Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     LeadTag[]

  @@unique([workspaceId, name])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([leadId])
}

model Consent {
  id        String   @id @default(cuid())
  leadId    String
  type      String // "marketing" | "recording" | "data_processing"
  granted   Boolean
  source    String? // where consent was captured
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Phase 1 — pipelines
// ---------------------------------------------------------------------------

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  leads     Lead[]

  @@index([workspaceId])
}

enum StageType {
  open
  won
  lost
}

model Stage {
  id               String    @id @default(cuid())
  pipelineId       String
  name             String
  type             StageType @default(open)
  order            Int
  requiredFieldIds String[]  @default([])
  onEnterAutomationId String?
  slaMinutes       Int?

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@index([pipelineId, order])
}

// ---------------------------------------------------------------------------
// Phase 1 — unified inbox
// ---------------------------------------------------------------------------

enum ConversationChannel {
  instagram
  whatsapp
}

model Conversation {
  id              String              @id @default(cuid())
  workspaceId     String
  leadId          String?
  channel         ConversationChannel
  windowExpiresAt DateTime?
  botActive       Boolean             @default(true)
  assignedToId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id])
  messages  Message[]

  @@index([workspaceId, leadId])
  @@index([workspaceId, assignedToId])
}

enum MessageDirection {
  inbound
  outbound
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  direction      MessageDirection
  type           String // "text" | "image" | "video" | "document" | "template" | "location" | "product"
  body           String?
  mediaUrl       String?
  templateId     String?
  status         String            @default("sent") // sent | delivered | read | failed
  externalId     String?           @unique
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 1 — automations
// ---------------------------------------------------------------------------

enum AutomationStatus {
  draft
  live
  scheduled
  paused
}

model Automation {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  folder      String?
  status      AutomationStatus @default(draft)
  triggerId   String?
  scheduleAt  DateTime?
  endAt       DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trigger   Trigger?            @relation(fields: [triggerId], references: [id])
  versions  AutomationVersion[]
  runs      AutomationRun[]

  @@index([workspaceId, status])
}

model AutomationVersion {
  id           String   @id @default(cuid())
  automationId String
  version      Int
  graph        Json // flow builder blocks + edges
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, version])
}

model Trigger {
  id     String @id @default(cuid())
  type   String // "comment_keyword" | "dm" | "story_reply" | "custom" | ...
  config Json

  automations Automation[]
}

model SavedTrigger {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String   @default("")
  config      Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String
  leadId       String?
  status       String   @default("running") // running | completed | failed | handed_over
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead       Lead?      @relation(fields: [leadId], references: [id])
  steps      RunStep[]

  @@index([automationId, status])
}

model RunStep {
  id        String   @id @default(cuid())
  runId     String
  blockId   String // node id within the automation graph
  type      String
  input     Json?
  output    Json?
  status    String   @default("ok") // ok | error | skipped
  startedAt DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model FlowTemplate {
  id          String   @id @default(cuid())
  workspaceId String? // null = public/system template
  name        String
  industry    String?
  scope       String   @default("private") // private | agency | public
  publishStatus String? // pending | approved | rejected: set when the author asks to publish publicly
  publishNote   String? // the reviewer's reason when rejected
  graph       Json
  variables   Json     @default("{}") // {business_name} etc.
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Phase 1 — messaging
// ---------------------------------------------------------------------------

model WaTemplate {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  category        String // marketing | utility | authentication
  language        String
  headerType      String    @default("none") // none | text | image | video | document
  headerText      String?
  bodyText        String
  footerText      String?
  buttons         Json      @default("[]")
  metaStatus      String    @default("pending") // pending | approved | rejected
  metaTemplateId  String? // Meta's id for this template, once submitted
  rejectionReason String?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([workspaceId])
}

model Broadcast {
  id             String    @id @default(cuid())
  workspaceId    String
  templateId     String
  audienceFilter Json      @default("{}")
  scheduledAt    DateTime?
  status         String    @default("draft") // draft | scheduled | sending | sent | failed
  costEstimate   Int? // in paise
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template   WaTemplate          @relation(fields: [templateId], references: [id])
  recipients BroadcastRecipient[]

  @@index([workspaceId])
}

model BroadcastRecipient {
  id          String   @id @default(cuid())
  broadcastId String
  leadId      String
  status      String   @default("pending") // pending | sent | delivered | failed | skipped

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
  @@index([leadId])
}

model QuickReply {
  id          String   @id @default(cuid())
  workspaceId String
  shortcut    String
  body        String
  mediaUrl    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
}

model Media {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  type        String // image | video | document
  filename    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Phase 1 — routing, scoring, tasks
// ---------------------------------------------------------------------------

model RoutingRule {
  id          String   @id @default(cuid())
  workspaceId String
  order       Int
  conditions  Json
  assignTo    Json // { type: "user" | "team" | "least_busy" | "round_robin", targetId? }
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, order])
}

model ScoringRule {
  id          String   @id @default(cuid())
  workspaceId String
  condition   Json
  points      Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Assignment {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  assignedAt DateTime @default(now())
  reassignedFromId String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
}

model SlaTimer {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  dueAt       DateTime
  escalatedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now()) // response-time start for the team-performance report

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dueAt])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  leadId      String?
  assignedToId String?
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id])

  @@index([workspaceId, assignedToId, completedAt])
}

model Sequence {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  steps       Json // ordered list of {waitHours, action}
  createdAt   DateTime @default(now())

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments SequenceEnrollment[]

  @@index([workspaceId])
}

model SequenceEnrollment {
  id         String    @id @default(cuid())
  sequenceId String
  leadId     String
  currentStep Int      @default(0)
  status     String    @default("active") // active | completed | stopped
  enrolledAt DateTime  @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([sequenceId, status])
}

// ---------------------------------------------------------------------------
// Phase 1 — plans, billing, usage (metering without AI cost yet)
// ---------------------------------------------------------------------------

model Subscription {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  planId      String
  status      String   @default("active") // active | trialing | past_due | canceled | paused
  billingCycle String  @default("monthly") // monthly | yearly
  trialEndsAt DateTime?
  currentPeriodEnd DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  workspaceId String
  description String   @default("") // e.g. "Growth plan — monthly", "Extra user x2", "1,000 AI credits"
  amountInr   Int
  gstInr      Int      @default(0)
  status      String   @default("pending") // pending | paid | failed | refunded
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  periodStart DateTime
  periodEnd   DateTime
  issuedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceAddon {
  id          String   @id @default(cuid())
  workspaceId String
  addonKey    String // extra_user | extra_instagram_account | extra_25k_contacts
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CreditLedger {
  id          String   @id @default(cuid())
  workspaceId String
  delta       Int // positive = credit added, negative = debited
  reason      String // "monthly_reset" | "topup" | "ai_reply" | "call_transcription" | ...
  balanceAfter Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model UsageEvent {
  id          String   @id @default(cuid())
  workspaceId String
  type        String // "ai_reply" | "call_minute" | "meeting_minute" | "broadcast_send" | ...
  quantity    Int      @default(1)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, createdAt])
}

model UsageMonthly {
  id          String   @id @default(cuid())
  workspaceId String
  yearMonth   String // "2026-09"
  aiCreditsUsed Int    @default(0)
  contactsCount Int    @default(0)
  usersCount    Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, yearMonth])
}

// ---------------------------------------------------------------------------
// Phase 2 item 1 — AI knowledge base (docs/PRD.md section 9)
// ---------------------------------------------------------------------------

model KnowledgeSource {
  id           String   @id @default(cuid())
  workspaceId  String
  type         String // "text" | "pdf" | "sheet" | "website"
  name         String
  // Raw text for text/pdf/sheet (pasted — see docs/PROGRESS.md Phase 2 item 1
  // simplification: no file upload/parsing yet, paste extracted text).
  content      String?
  sourceUrl    String? // fetched + stripped to text server-side for "website"
  status       String   @default("pending") // pending | ready | failed
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]
  faqs      Faq[]

  @@index([workspaceId])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  workspaceId String
  sourceId    String
  content     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
}

model Faq {
  id          String   @id @default(cuid())
  workspaceId String
  question    String
  answer      String
  sourceId    String?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model AiSettings {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique
  tone                    String   @default("friendly")
  languages               String[] @default(["en"])
  answerOnlyFromSources   Boolean  @default(true)
  handoverWhenUnsure      Boolean  @default(true)
  handoverOnDiscountAsked Boolean  @default(true)
  alwaysEndWithNextStep   Boolean  @default(true)
  replyInLeadsLanguage    Boolean  @default(true)
  sharePricesToggle       Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 2 item 6 — Link in bio (docs/PRD.md section 12, `LinkInBio`)
// ---------------------------------------------------------------------------

model LinkInBioPage {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  slug        String   @unique
  title       String
  bio         String?
  whatsappPhone String? // digits only, used for the wa.me button
  brochureUrl String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 2 item 7 — Calendar and booking (Google Calendar, docs/PRD.md section 11)
// ---------------------------------------------------------------------------

// One per user per workspace: each team member connects their own Google
// account via OAuth. Tokens are encrypted at rest like every channel token.
model CalendarAccount {
  id                 String    @id @default(cuid())
  workspaceId        String
  userId             String
  googleEmail        String?
  refreshTokenCipher String
  status             String    @default("active") // active | revoked
  connectedAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model AppointmentType {
  id           String   @id @default(cuid())
  workspaceId  String
  hostUserId   String
  name         String
  durationMin  Int
  bufferMin    Int      @default(0)
  minNoticeMin Int      @default(60)
  reminderHoursBefore Int? // null = no reminder
  reminderTemplateId  String? // approved WaTemplate sent to the guest
  availability Json // [{ day: 0-6, start: "HH:MM", end: "HH:MM" }] in the workspace timezone
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]

}

model Appointment {
  id                String   @id @default(cuid())
  workspaceId       String
  appointmentTypeId String
  leadId            String?
  hostUserId        String
  startsAt          DateTime
  endsAt            DateTime
  status            String   @default("booked") // booked | cancelled
  guestName         String
  guestPhone        String
  googleEventId     String?
  reminderStatus   String? // sent | failed
  reminderSentAt   DateTime?
  reminderError    String?
  createdAt         DateTime @default(now())

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([hostUserId, startsAt])
}

// ---------------------------------------------------------------------------
// Platform admin — integration credentials set from the super admin dashboard
// ---------------------------------------------------------------------------

// Third-party credentials (Google, Meta, Razorpay, ...). Every value is
// encrypted at rest with TOKEN_ENCRYPTION_KEY, like channel tokens.
model PlatformSetting {
  key             String   @id
  valueCipher     String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

// Platform-level audit trail. Records which setting changed, never the value.
model PlatformAuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // setting.set | setting.cleared | limits.set | credits.granted
  key       String?
  workspaceId String? // for actions on one workspace (not a relation: the log outlives it)
  detail    String? // human summary, never a secret value
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Developers — public API keys and outbound webhooks
// ---------------------------------------------------------------------------

// Only the SHA-256 of the key is stored; the full key is shown once at
// creation. `prefix` is the first characters, for telling keys apart in the UI.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[] // leads:read | leads:write
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  workspaceId  String
  url          String
  description  String?
  secretCipher String // signing secret, encrypted like channel tokens
  events       String[] // lead.created | lead.stage_changed | appointment.booked
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  workspaceId    String
  endpointId     String
  event          String // an event name, or "ping" for a test
  payload        Json
  status         String    @default("pending") // pending | retrying | delivered | failed
  attempts       Int       @default(0)
  responseStatus Int?
  error          String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
}

// Owner console: a super admin's per-workspace override of plan limits. A null
// column means "no override" — the plan (plus add-ons) applies.
model WorkspaceLimitOverride {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  contacts        Int?
  users           Int?
  instagramAccounts Int?
  note            String?
  updatedById     String
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 3 — agencies: manage several client workspaces from one login. Clients
// still pay Zenora directly (no white label / reselling).
// ---------------------------------------------------------------------------

model Agency {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members AgencyMember[]
  clients Workspace[]
}

model AgencyMember {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String
  role      String   @default("admin") // owner | admin
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Phase 3 — refer and earn. Commission is a ledger: Zenora records what is owed
// and what was paid; any actual payment happens outside the app.
// ---------------------------------------------------------------------------

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per referred business. Attribution is fixed when the workspace is
// created; a workspace can only ever be referred once.
model Referral {
  id                  String   @id @default(cuid())
  referrerUserId      String
  referredWorkspaceId String?  @unique // null once that workspace has been deleted; the earned commissions stay
  referredName        String   @default("") // the business's name at referral time, for when the workspace is gone
  code                String
  createdAt           DateTime @default(now())

  referredWorkspace Workspace?        @relation(fields: [referredWorkspaceId], references: [id], onDelete: SetNull)
  commissions       CommissionEntry[]

  @@index([referrerUserId])
}

model CommissionEntry {
  id         String   @id @default(cuid())
  referralId String
  invoiceId  String   @unique // one commission per paid invoice, ever
  baseInr    Int // invoice amount before GST
  pct        Int
  amountInr  Int
  status     String   @default("accrued") // accrued | paid | void
  payoutId   String?
  createdAt  DateTime @default(now())
  // The invoice was refunded AFTER this commission had been paid out: the money
  // is owed back by the referrer until the owner marks it recovered.
  refundedAt          DateTime?
  clawbackRecoveredAt DateTime?

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  payout   Payout?  @relation(fields: [payoutId], references: [id])

  @@index([referralId])
  @@index([status])
}

// A payment the platform owner made to a referrer outside Zenora, recorded here.
model Payout {
  id               String   @id @default(cuid())
  referrerUserId   String
  amountInr        Int
  reference        String // e.g. bank transfer / UTR reference
  partnerInvoiceRef String? // the referrer's GST invoice number this settles
  paidById         String
  createdAt        DateTime @default(now())

  entries CommissionEntry[]

  @@index([referrerUserId])
}

// A copy of an invoice kept after its workspace is deleted. Tax law requires
// invoices to be kept for years, so they are copied here (no link to the
// workspace) before the workspace and everything else about the customer goes.
// It holds the business's billing details, never contacts or messages.
model RetainedInvoice {
  id                String   @id @default(cuid())
  originalInvoiceId String   @unique
  formerWorkspaceId String // plain text: the workspace no longer exists
  businessName      String?
  gstin             String?
  billingAddress    String?
  description       String
  amountInr         Int
  gstInr            Int
  status            String
  razorpayOrderId   String?
  razorpayPaymentId String?
  periodStart       DateTime
  periodEnd         DateTime
  issuedAt          DateTime
  deletedAt         DateTime @default(now())
  retainUntil       DateTime

  @@index([formerWorkspaceId])
  @@index([retainUntil])
}

// The super admin's changes to plan prices and limits, applied over the shipped
// defaults. One row (id "plans"). History lives in PlatformAuditLog.
model PlanConfigOverride {
  id          String   @id // always "plans"
  data        Json
  updatedById String
  updatedAt   DateTime @updatedAt
}
