{
  "name": "zenora",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @zenora/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @zenora/db migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @zenora/db migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @zenora/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @zenora/db studio"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0"
  }
}
